# .gitignore for .NET 9 Web API
# Build results
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Dotnet watch
**/node_modules/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Publish output
publish/

# Configuration files
appsettings.*.json
!appsettings.json

# Others
*.db
*.sqlite
*.pdb
*.mdb
*.bak
*.swp
*.swo

# Rider
.idea/
*.sln.iml

# Test results
TestResults/

# Azure Pipelines
*.azure-pipelines.yml

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper

# Local history for VS Code
.history/

# NCrunch
.ncrunch*
*.ncrunch*

# Coverlet coverage
coverage*

# SonarQube
.sonar/
